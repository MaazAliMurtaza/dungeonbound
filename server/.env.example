PORT=4000
# Set to 1 on Render or a host with exactly one trusted reverse proxy; leave unset locally.
# TRUST_PROXY=1
NODE_ENV=development
DATABASE_URL=postgresql://dungeonbound:dungeonbound_dev_password@localhost:5432/dungeonbound
