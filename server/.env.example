PORT=4000
# Set to 1 on Render or a host with exactly one trusted reverse proxy; leave unset locally.
# TRUST_PROXY=1
NODE_ENV=development
DATABASE_URL=postgresql://dungeonbound:dungeonbound_dev_password@localhost:5432/dungeonbound
# Hosted Supabase: use the session-pooler URL from its Connect panel.
# DATABASE_SCHEMA=dungeonbound
# DATABASE_CA_CERT=PEM certificate if the provider's CA is not in Node's trust store.
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
